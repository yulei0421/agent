DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional OpenAI-compatible fallback. Configure all three values together.
# It is used only when the primary model fails before emitting any event.
# MODEL_FALLBACK_API_KEY=your_fallback_api_key
# MODEL_FALLBACK_BASE_URL=https://fallback.example
# MODEL_FALLBACK_NAME=fallback-model
# Model-stream resilience settings. All timeouts are milliseconds.
MODEL_TOTAL_TIMEOUT_MS=60000
MODEL_FIRST_EVENT_TIMEOUT_MS=15000
MODEL_IDLE_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=1
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_COOLDOWN_MS=30000
PORT=8787
CLIENT_URL=http://127.0.0.1:5173
# Set to true only when exactly one trusted reverse proxy forwards client IPs.
TRUST_PROXY=false

# Public financial data providers used for development and internal demos.
BINANCE_REST_BASE_URL=https://api.binance.com
# Optional absolute path to a CJK TrueType font for PDF research exports.
# PDF_CJK_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
