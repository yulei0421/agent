DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Optional OpenAI-compatible fallback. Configure all three values together.
# It is used only when the primary model fails before emitting any event.
# MODEL_FALLBACK_API_KEY=your_fallback_api_key
# MODEL_FALLBACK_BASE_URL=https://fallback.example
# MODEL_FALLBACK_NAME=fallback-model
# Optional task-specific model slots. Configure all three values for a slot.
# MODEL_FAST_API_KEY=your_fast_api_key
# MODEL_FAST_BASE_URL=https://fast.example
# MODEL_FAST_NAME=fast-model
# MODEL_REASONING_API_KEY=your_reasoning_api_key
# MODEL_REASONING_BASE_URL=https://reasoning.example
# MODEL_REASONING_NAME=reasoning-model
# MODEL_STRUCTURED_API_KEY=your_structured_api_key
# MODEL_STRUCTURED_BASE_URL=https://structured.example
# MODEL_STRUCTURED_NAME=structured-model
# Model-stream resilience settings. All timeouts are milliseconds.
MODEL_TOTAL_TIMEOUT_MS=60000
MODEL_FIRST_EVENT_TIMEOUT_MS=15000
MODEL_IDLE_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=1
MODEL_CIRCUIT_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_COOLDOWN_MS=30000
PORT=8787
CLIENT_URL=http://127.0.0.1:5173
# Set to true only when exactly one trusted reverse proxy forwards client IPs.
TRUST_PROXY=false
# Comma-separated public domains that the browser sandbox may visit.
# BROWSER_ALLOWED_DOMAINS=example.com,docs.example.com
# Optional OpenAI-compatible embeddings provider. Without it a deterministic
# request-scoped local embedding fallback is used.
# EMBEDDING_API_KEY=your_embedding_api_key
# EMBEDDING_ENDPOINT=https://embedding.example/v1/embeddings
# EMBEDDING_MODEL=text-embedding-3-small

# Public financial data providers used for development and internal demos.
BINANCE_REST_BASE_URL=https://api.binance.com
# Optional absolute path to a CJK TrueType font for PDF research exports.
# PDF_CJK_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# OCR settings for image and scanned-PDF attachments.
OCR_LANGUAGE=chi_sim+eng
# Optional absolute paths when Tesseract assets are not available from the package defaults.
# TESSERACT_LANG_PATH=/opt/tesseract/lang-data
# TESSERACT_WORKER_PATH=/opt/tesseract/worker.min.js
# TESSERACT_CORE_PATH=/opt/tesseract/tesseract-core.wasm.js
