{
  "name": "deepseek-agent-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx watch server/bootstrap.ts\" \"vite --host 127.0.0.1\"",
    "server": "tsx server/bootstrap.ts",
    "client": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "desktop:dev": "concurrently -k \"pnpm server\" \"pnpm client\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:127.0.0.1:5173 file:dist-electron/main.js && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron dist-electron/main.js\"",
    "desktop:build": "pnpm build && pnpm build:server && pnpm build:electron && electron-builder",
    "test": "tsx --test tests/*.test.ts",
    "test:ts": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.8",
    "@napi-rs/canvas": "0.1.100",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/websockets": "^11.1.28",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "express": "^5.1.0",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tesseract.js": "^6.0.1",
    "vite": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "wait-on": "^9.1.0"
  },
  "main": "dist-electron/main.js",
  "build": {
    "appId": "com.deepseek.agent.demo",
    "productName": "DeepSeek Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**",
      "dist/**",
      "dist-server/**",
      "package.json"
    ],
    "asarUnpack": [
      "dist/**",
      "dist-server/**",
      "node_modules/**"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
